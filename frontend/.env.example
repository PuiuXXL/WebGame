# Public origin used by the QR AND the WebSocket connection (no /game suffix).
# Local: http://<computer-LAN-IP>:5173
# Hosting: https://<your-domain>
# Empty: use the origin of the page currently open in the browser.
VITE_PUBLIC_APP_URL=

# Optional override ONLY when WebSocket is hosted at a different public endpoint.
# Empty: derive ws(s)://<VITE_PUBLIC_APP_URL host>/ws.
VITE_REALTIME_URL=

# Internal backend destination for Vite's local /ws proxy; not sent to browsers.
# On hosting, configure /ws on the reverse proxy instead.
BACKEND_URL=http://127.0.0.1:8080
